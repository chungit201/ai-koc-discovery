flowchart TD
    Q["'book 5 KOC thì chia 100 triệu thế nào?'"] --> P["Sonnet + MCP koc<br/>INTRO_CAMPAIGN koc-agent-v4 + RULES"]
    P --> T1["campaign_context — luôn gọi đầu tiên<br/>tiêu chí · điểm thành phần · cost_estimate · bằng chứng S2"]
    T1 --> T2["allocate_budget(total, basis='fit')<br/>code chia tiền · làm tròn 100k · tổng khớp tuyệt đối"]
    T2 --> CHK{"có KOC không đủ 1 video?"}
    CHK -->|có| T3["summary RA LỆNH gọi lại basis='cost'<br/>tự so 2 cách, CẤM hỏi lại người dùng"]
    CHK -->|không| W
    T3 --> W["Viết JSON: blocks + follow_ups"]

    W --> SAN["sanitize() — hàng rào theo từng loại khối"]
    SAN --> B1["para / bullets<br/>mọi số phải nằm trong claim được trích"]
    SAN --> B2["table<br/>code chép rows từ evidence<br/>model không viết số nào"]
    SAN --> B3["advice<br/>miễn trích dẫn…"]
    B3 --> B3a{"câu có triệu / tỉ / % / ₫ ?"}
    B3a -->|có| B3b["…trừ khi nêu tiền hoặc tỉ lệ<br/>→ vẫn phải kiểm chứng như para"]
    B3a -->|không| B3c["giữ — 'chia 2 đợt'<br/>'phí nền + hoa hồng'"]

    B1 --> OUT2["blocks còn lại"]
    B2 --> OUT2
    B3b --> OUT2
    B3c --> OUT2
    OUT2 --> E{"rỗng?"}
    E -->|có| LOG["console.warn: parse hỏng hay bộ lọc gạt hết<br/>+ 400 ký tự đầu"]
    E -->|không| OK["Tin nhắn hiện ra"]

    classDef moi fill:#fef3c7,stroke:#d97706,stroke-width:2px
    class T2,T3,B3,B3a,B3b,B3c,LOG moi
