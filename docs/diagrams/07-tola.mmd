flowchart TD
    IN["Người bán gõ MỘT ô chat<br/>(màn /tola · trang KOC · trong hội thoại)"]
    IN --> MEN["Giải nghĩa tag @handle<br/>lib/mentions.ts — code tra DB, không để agent đoán"]
    MEN --> R{"Câu hỏi thuộc loại nào?"}

    R -->|"BRIEF TÌM KOC<br/>nêu sản phẩm + số KOC / ngân sách / khán giả"| A1
    R -->|"HỎI VỀ KOC CỤ THỂ<br/>có @handle, hoặc tên KOC"| B1
    R -->|"TRA CỨU / XẾP HẠNG<br/>'ai doanh thu cao nhất'"| C1
    R -->|"NGOÀI DỮ LIỆU<br/>phốt, tiểu sử, thương hiệu, tin tức"| D1

    subgraph A ["① Tìm KOC — chạy phân tích sâu, trả kết quả NGAY TRONG CHAT"]
        A1["Hiểu yêu cầu · parseBrief (Haiku)<br/>→ tiêu chí + kế hoạch các bước"]
        A1 --> A2["Lọc & chấm điểm toàn bộ pool · S2<br/>7 tiêu chí có trọng số · sinh ~2.400 bằng chứng · 0 token"]
        A2 --> A3["Đọc nội dung nhóm dẫn đầu · S3<br/>bio + sản phẩm đã bán + tiêu đề video"]
        A3 --> A4["Xem khung hình video · S4<br/>4 khung/video, KHÔNG có tiếng"]
        A4 --> A5["Chọn KOC trong ngân sách, chia tiền · S5<br/>mỗi lý do kèm bằng chứng"]
    end

    subgraph B ["② Hỏi về một KOC"]
        B1["get_overview · category_breakdown<br/>list_products(product) · list_videos<br/>analyze_videos · get_daily · get_peers"]
    end

    subgraph C ["③ Tra cứu & xếp hạng"]
        C1["search_creators<br/>lọc theo sản phẩm, follower, doanh thu, MCN<br/>xếp theo doanh thu / tương tác / tăng trưởng"]
    end

    subgraph D ["④ Ngoài dữ liệu Kalodata"]
        D1["get_overview trước — xác nhận DB KHÔNG có,<br/>lấy tên/handle/thương hiệu làm từ khoá"]
        D1 --> D2["WebSearch / WebFetch<br/>ưu tiên kênh chính chủ, báo chí Việt Nam"]
    end

    A5 --> EV
    B1 --> EV
    C1 --> EV
    D2 --> EV

    EV["Mỗi kết quả công cụ = 1 bản ghi evidence của phiên<br/>summary (số đã định dạng) + rows + numbers thô"]
    EV --> W["Agent viết markdown tự do<br/>tự chọn bố cục, cột bảng, chỗ đặt dẫn chứng"]
    W --> V{"KIỂM ĐẦU RA · lib/answer-verify.ts"}

    V --> V1["Mọi con số ↔ numbers + claim của evidence phiên<br/>sai số 2% · số đếm nhỏ được miễn"]
    V --> V2["@handle trong link ↔ rows của công cụ đã gọi<br/>không khớp → GỠ LINK, giữ chữ"]
    V --> V3["URL ngoài ↔ kết quả WebSearch/WebFetch của phiên"]
    V --> V4["Dấu trích dẫn do agent đặt → chip nguồn bấm được"]

    V1 --> OUT
    V2 --> OUT
    V3 --> OUT
    V4 --> OUT
    OUT["Câu trả lời trong chat<br/>văn xuôi + bảng + chip nguồn + gợi ý hỏi tiếp"]

    classDef lane fill:#f3f4fe,stroke:#8b93e8
    classDef guard fill:#fef3c7,stroke:#d97706
    class A,B,C,D lane
    class V,V1,V2,V3,V4 guard
