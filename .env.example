KALODATA_API_KEY=
KALODATA_BASE_URL=https://www.kalodata.com

# MongoDB (via SSH tunnel: npm run db:tunnel)
MONGODB_URI=mongodb://detola:<password>@127.0.0.1:27117/detola?authSource=detola
MONGODB_DB=detola

# LLM runs through the local Claude CLI (`claude -p`), no API key needed
CLAUDE_CLI_PATH=claude

# Kalodata web crawler account (separate from the account used in the browser)
KALODATA_WEB_USERNAME=
KALODATA_WEB_PASSWORD=
KALODATA_WEB_SESSION=.auth/kalodata-crawler.json
KALODATA_WEB_INTERVAL_MS=5000
KALODATA_WEB_MAX_PER_HOUR=300
KALODATA_WEB_MAX_PER_DAY=1200

# Open API costs credits — keep 0 unless the user approves spending
KALODATA_API_ENABLED=0
